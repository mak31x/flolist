{
  "name": "flolist",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm infra:up && turbo run dev",
    "check": "pnpm format:check && turbo run lint typecheck test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml --project-directory . up -d --wait && docker compose -f infra/docker-compose.dev.yml --project-directory . run --rm rustfs-init",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml --project-directory . down",
    "db:generate": "pnpm --filter @flolist/db db:generate",
    "db:migrate": "pnpm --filter @flolist/db db:migrate",
    "db:seed": "pnpm --filter @flolist/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
