{
  "name": "@flolist/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node ../../scripts/bundle-node.mjs api=src/index.ts migrate=src/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@flolist/db": "workspace:*",
    "@flolist/shared": "workspace:*",
    "@hono/node-server": "2.1.11",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.21",
    "nodemailer": "10.6.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/nodemailer": "8.0.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  }
}
