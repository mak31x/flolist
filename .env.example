# Copy to .env (gitignored) and adjust. Every value here is a dev-only default.
# Production uses infra/prod.env.example instead (copied to /opt/flolist/.env on the VM).
# Host ports are offset from the defaults (5433, 9010, 1026, 8026) so Flolist can run next to other local stacks.

# --- Ports -------------------------------------------------------------------
# Vite dev server. It proxies /api and /ws to the API, like Caddy does in prod.
WEB_PORT=5174
API_HOST=127.0.0.1
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent (dev logs are pretty-printed)
LOG_LEVEL=info
# Requests per client (user, else IP) per window on /api/*
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# true behind Caddy, so the client IP comes from X-Forwarded-For
TRUST_PROXY=false

# --- Postgres (infra/docker-compose.dev.yml) ---------------------------------
POSTGRES_USER=flolist
POSTGRES_PASSWORD=flolist
POSTGRES_DB=flolist
POSTGRES_PORT=5433
DATABASE_URL=postgres://flolist:flolist@localhost:5433/flolist
# API integration tests start their own Postgres container (Testcontainers).
# Set this to an admin URL (database "postgres") to use an existing server instead.
# TEST_DATABASE_URL=postgres://flolist:flolist@localhost:5433/postgres

# --- S3-compatible storage (RustFS in dev, OCI Object Storage in prod) -------
S3_ENDPOINT=http://localhost:9010
S3_PORT=9010
S3_CONSOLE_PORT=9011
S3_REGION=us-east-1
S3_BUCKET=flolist
S3_ACCESS_KEY=flolist
S3_SECRET_KEY=flolist-dev-secret

# --- Email (Mailpit in dev; UI at http://localhost:8026) ---------------------
SMTP_HOST=localhost
SMTP_PORT=1026
# Implicit TLS; empty = on for port 465 only. Mailpit needs no TLS and no auth.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAILPIT_UI_PORT=8026
MAIL_FROM="Flolist <no-reply@flolist.localhost>"

# --- Limits (D-013) ----------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_WORKSPACE_STORAGE_GB=
MAX_LIST_MEMBERS=25
# Empty = unlimited
MAX_TEAM_MEMBERS=
