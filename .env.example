# Copy to .env (gitignored) and adjust. Every value here is a dev-only default.
# Production uses infra/prod.env.example instead (copied to /opt/flolist/.env on the VM).
# Host ports are offset from the defaults (5433, 9010, 1026, 8026) so Flolist can run next to other local stacks.

# --- Ports -------------------------------------------------------------------
# Vite dev server. It proxies /api and /ws to the API, like Caddy does in prod.
WEB_PORT=5174
API_HOST=127.0.0.1
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent (dev logs are pretty-printed)
LOG_LEVEL=info
# Requests per client (user, else IP) per window on /api/*
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# true behind Caddy, so the client IP comes from X-Forwarded-For
TRUST_PROXY=false

# --- Auth (Better Auth, D-005) -------------------------------------------------
# Public origin of the app; the auth API lives at $APP_URL/api/auth.
APP_URL=http://localhost:5174
# Any 32+ characters in dev. Production refuses this value.
BETTER_AUTH_SECRET=flolist-dev-only-secret-change-me-0000
# Google sign-in is on only when both are set (Google Cloud → OAuth client, type "Web application",
# redirect URI http://localhost:5174/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in, sign-up, password reset and verification emails, per client IP
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# --- Postgres (infra/docker-compose.dev.yml) ---------------------------------
POSTGRES_USER=flolist
POSTGRES_PASSWORD=flolist
POSTGRES_DB=flolist
POSTGRES_PORT=5433
DATABASE_URL=postgres://flolist:flolist@localhost:5433/flolist
# API integration tests start their own Postgres container (Testcontainers).
# Set this to an admin URL (database "postgres") to use an existing server instead.
# TEST_DATABASE_URL=postgres://flolist:flolist@localhost:5433/postgres

# --- S3-compatible storage (RustFS in dev, OCI Object Storage in prod) -------
S3_ENDPOINT=http://localhost:9010
S3_PORT=9010
S3_CONSOLE_PORT=9011
S3_REGION=us-east-1
S3_BUCKET=flolist
S3_ACCESS_KEY=flolist
S3_SECRET_KEY=flolist-dev-secret
# Host browsers use for presigned upload/download URLs, if it differs from S3_ENDPOINT
# (e.g. the API reaches storage on a Docker network). Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# true = browsers PUT uploads straight to presigned bucket URLs (the bucket needs CORS for
# APP_URL; dev RustFS gets it from rustfs-init). false = the API relays the bytes (D-037).
S3_DIRECT_UPLOAD=true
# Browser origins allowed to PUT to the dev bucket (applied by the rustfs-init service).
S3_CORS_ORIGINS=http://localhost:5174

# --- Email (Mailpit in dev; UI at http://localhost:8026) ---------------------
SMTP_HOST=localhost
SMTP_PORT=1026
# Implicit TLS; empty = on for port 465 only. Mailpit needs no TLS and no auth.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAILPIT_UI_PORT=8026
MAIL_FROM="Flolist <no-reply@flolist.localhost>"

# --- Limits (D-013) ----------------------------------------------------------
MAX_UPLOAD_MB=25
# Empty = unlimited
MAX_WORKSPACE_STORAGE_GB=
# Upload reservations per user per window
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
MAX_LIST_MEMBERS=25
# Empty = unlimited
MAX_TEAM_MEMBERS=
