# Flolist's own Caddy: serves the SPA and proxies the API over plain HTTP (CADDY_SITE=":80").
# The VM's front proxy terminates TLS and forwards here (docs/deploy-oracle.md).
{
	# The admin API stays on (container-local :2019) so the deploy job can `caddy reload`.
	servers {
		# Keep the real client IP from the front proxy (it reaches us over a Docker network).
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

{$CADDY_SITE::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /ws {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/releases/current
		header -Server

		# Hashed build assets never change.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Everything else (index.html via the SPA fallback, the service worker, covers) is
		# revalidated. `header` runs before `try_files`, so match on "not hashed", not on index.html.
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"

		# SPA fallback: unknown paths get index.html (no-cache) and the router takes over.
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
}
