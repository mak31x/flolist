# Production env for /opt/flolist/.env on the VM (chmod 600, owned by the deploy user).
# Copy this file there and fill in the secrets. Never commit the real file.
# Generate secrets with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- Public URL ----------------------------------------------------------------
# Changing domain later (e.g. app.flolist.com) = change APP_URL + the front proxy's site + DNS.
APP_URL=https://flolist.levitatinglabs.com

# --- Auth (Better Auth, D-005) -------------------------------------------------------
# Required: the API refuses to start in production without a real secret.
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
# Google sign-in stays off until both are set (redirect URI $APP_URL/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# --- Flolist's Caddy (infra/Caddyfile) -------------------------------------------
# Plain HTTP; the front proxy (n8n stack's Caddy) terminates TLS and forwards to flolist-web:80.
CADDY_SITE=:80
# Docker network shared with the front proxy.
FRONT_PROXY_NETWORK=n8n-docker_default
# Loopback port used by the deploy job's health check.
CADDY_BIND_HTTP=127.0.0.1:8088

# --- Postgres --------------------------------------------------------------------
POSTGRES_USER=flolist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flolist

# --- API -------------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- Email (D-032: Hostinger SMTP, implicit TLS on 465) ----------------------------
# Temporarily an existing startrips.in mailbox, used as login and sender. Put the real
# address and password only in /opt/flolist/.env; single-quote the password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASS='change-me'
MAIL_FROM="Flolist <sender@example.com>"

# --- Files (D-037: OCI Object Storage via its S3 API; runbook in docs/deploy-oracle.md) --
# Without these, uploads answer 503 and profile photos can't be set.
S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_REGION=<region>
S3_BUCKET=flolist-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
# OCI's S3 API has no bucket CORS, so the API relays upload bytes (keep false).
S3_DIRECT_UPLOAD=false
UPLOAD_RATE_LIMIT_MAX=30

# --- Limits (D-013) --------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_WORKSPACE_STORAGE_GB=
MAX_LIST_MEMBERS=25
MAX_TEAM_MEMBERS=

# --- Backups (infra/scripts/backup.sh) -------------------------------------------
# Kept on the VM until M8.3 moves them to object storage.
BACKUP_DIR=/opt/flolist/backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
